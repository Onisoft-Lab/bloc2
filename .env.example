# Copier ce fichier en .env et renseigner les valeurs.
# Le fichier .env ne doit JAMAIS être commité (voir .gitignore).

# Connexion PostgreSQL (format SQLAlchemy + psycopg 3)
DATABASE_URL=postgresql+psycopg://veloville:veloville@localhost:5432/veloville

# Jeton JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Front Streamlit : adresse de l'API
API_URL=http://localhost:8000
API_TIMEOUT_SECONDES=5

# Mot de passe des comptes de recette, lu par pytest. La valeur est dans le README.
COMPTE_MOT_DE_PASSE=
